# Authentication Secret (Used for JWT signing and stateless HMAC OTP verification)
SESSION_SECRET=dev-session-secret-change-this-in-production-1234567890

# Resend API (Optional: provide to send real emails in production)
# Get your free API key at: https://resend.com
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Auth <onboarding@resend.dev>

# Firebase Configuration (For Google Sign-In and Free Phone SMS OTP)
# Get your keys from Firebase Console > Project Settings > General > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
